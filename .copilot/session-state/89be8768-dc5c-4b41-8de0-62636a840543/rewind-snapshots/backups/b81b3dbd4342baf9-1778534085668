name: 'asha_models'
version: '1.0.0'

profile: 'asha_models'

model-paths: ["models"]
analysis-paths: ["analyses"]
test-paths: ["tests"]
seed-paths: ["seeds"]
macro-paths: ["macros"]
snapshot-paths: ["snapshots"]

clean-targets:
  - "target"
  - "dbt_packages"
  
models:
  asha_models:
    01_Loading:
      +materialized: view
      +schema: bronze
      +file_format: parquet
      +static_analysis: off
    02_Staging:
      +materialized: view
      +schema: staging
      +static_analysis: off
    03_Silver:
      +materialized: table
      +schema: silver
      +file_format: parquet
      +static_analysis: off
    04_Gold:
      +materialized: table
      +schema: gold
      +file_format: parquet
      +static_analysis: off

snapshots:
  asha_models:
    +materialized: snapshot
    +schema: history
    +file_format: parquet

seeds:
  asha_models:
    +schema: reference
    +file_format: parquet